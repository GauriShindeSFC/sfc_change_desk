
# ─────────────────────────────────────────────
#  ChangeDesk Backend – Environment Variables
#  Copy this file to `.env` and adjust as needed.
# ─────────────────────────────────────────────

# HTTP port the API listens on
PORT=5001

# Runtime environment: development | production
NODE_ENV=development

# Allowed CORS origins (comma-separated). Use * to allow any origin.
CORS_ORIGIN=http://localhost:5174

# PostgreSQL connection string, e.g. Supabase session pooler (port 5432)
DATABASE_URI=postgresql://USER:PASSWORD@HOST:5432/postgres

# Set to true to log every SQL statement Sequelize runs
DB_LOGGING=false

# Database Connection Pool Settings (Optimized for Supabase Pooler)
DB_POOL_MAX=10
DB_POOL_MIN=2

# Auth: secret used to sign session JWTs (override in production)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Shared password given to every seeded user by `npm run db:sync`
SEED_USER_PASSWORD=changedesk123

# ── Microsoft Entra ID (Azure AD) Single Sign-On (SSO) ────────────
# Fill these in when integrating Microsoft 365 OAuth SSO
AZURE_TENANT_ID=your-azure-tenant-id-here
AZURE_CLIENT_ID=your-azure-client-id-here

# ── Email notifications (nodemailer / SMTP) ──────────────────────
# Flip MAIL_ENABLED to true and fill SMTP_* to send real emails to inboxes.
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=changedesk@example.com
SMTP_PASS=your-smtp-password-or-app-password
MAIL_FROM=ChangeDesk <no-reply@example.com>

# Fallback inbox used when no active "CAB Approver" user has an email
MAIL_APPROVER_FALLBACK=cab-board@example.com

# Used to build "open in app" links inside notification emails
APP_BASE_URL=http://localhost:5174

# Logo shown in the email header (defaults to APP_BASE_URL/images/white-stfox-logo.png)
MAIL_LOGO_URL=

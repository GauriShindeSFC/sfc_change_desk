# ─────────────────────────────────────────────
#  ChangeDesk Frontend – Environment Variables
#  Copy this file to `.env` and adjust as needed.
#  Only vars prefixed with VITE_ are exposed to the client bundle.
# ─────────────────────────────────────────────

# Base URL of the ChangeDesk backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:5001/api/dashboard
